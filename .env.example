# RustFS S3 mount for Ubuntu.
# Copy this file to .env and set the four required values.
# The installer reads each value literally, so $, &, and # stay as written.
# A quote you add around a value is kept as part of the value.
# Lines starting with # are comments.

ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=https://s3.example.com
S3_ROOT=/mnt/s3

# Optional. Omit a line to keep the built-in value.
# REMOTE_NAME=s3
# REGION=us-east-1
# VOLUME_NAME=S3 drive
# LOG_FILE=/home/you/.cache/rclone/s3-mount.log
